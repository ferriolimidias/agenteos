# ==========================================
# PostgreSQL (compose + backend)
# ==========================================
POSTGRES_USER=postgres
POSTGRES_PASSWORD=sua_senha_super_secreta
POSTGRES_DB=agent_os

# ==========================================
# Redis (opcional no .env — o docker-compose injeta REDIS_URL no backend)
# ==========================================
# REDIS_URL=redis://redis:6379/0

# ==========================================
# Deploy VPS (Nginx + Certbot / scripts)
# ==========================================
DOMAIN=app.seudominio.com
EMAIL=admin@seudominio.com

# ==========================================
# Evolution API (rede interna Docker)
# EVOLUTION_API_TOKEN: autenticação global na Evolution (header apikey nas rotas administrativas)
# EVOLUTION_API_URL: URL que o backend usa para falar com o container evolution
# ==========================================
EVOLUTION_API_URL=http://evolution:8080
EVOLUTION_API_TOKEN=defina_um_token_forte_em_producao

# Chaves OpenAI por tenant ficam no painel (credenciais da empresa / config global).
# DATABASE_URL para o backend é montado pelo docker-compose a partir do POSTGRES_* acima.
# AGENTEOS_LLM_MODE vazio usa provider real quando o tenant tem chave válida.
# Use AGENTEOS_LLM_MODE=mock apenas em teste/CI/ambiente isolado.
AGENTEOS_LLM_MODE=

# A11 prompt optimizer: all live behavior remains disabled unless an explicit
# tenant pilot and individual gates are enabled during a separately approved release.
A11_AB_LIVE_ENABLED=false
A11_AUTO_PROMOTION_LIVE_ENABLED=false
A11_AUTO_ROLLBACK_LIVE_ENABLED=false
A11_AUTO_PROMPT_MUTATION_ENABLED=false
A11_PILOT_TENANT_IDS=

# OpenAI model catalog cache; default is 30 minutes, bounded to 1 minute–24 hours.
OPENAI_MODEL_CATALOG_TTL_SECONDS=1800

# ==========================================
# Meta Official WhatsApp Cloud API / Embedded Signup
# Não colocar valores reais no repositório.
# META_LIVE_ACTIONS_ENABLED deve ficar false até teste real controlado.
# META_CREDENTIAL_ENCRYPTION_KEY precisa ter no mínimo 32 caracteres e ser persistente.
# ==========================================
META_APP_ID=
META_APP_SECRET=
META_EMBEDDED_SIGNUP_CONFIG_ID=
META_GRAPH_API_VERSION=v25.0
META_WEBHOOK_VERIFY_TOKEN=
META_REDIRECT_URI=
META_CREDENTIAL_ENCRYPTION_KEY=
META_LIVE_ACTIONS_ENABLED=false

# Meta Business Messaging Dataset API foundation. Keep disabled until a
# controlled tenant-scoped test is explicitly authorized.
META_SYSTEM_USER_TEST_ENABLED=false
META_SYSTEM_USER_TEST_TENANT_IDS=
META_SYSTEM_USER_ACCESS_TOKEN=
META_BUSINESS_MESSAGING_TEST_ENABLED=false
META_PARTNER_AGENT=

# Meta Marketing API / Traffic MVP foundation.
# Read-only foundation uses v26.0 without changing WhatsApp/Instagram/CAPI versions.
META_MARKETING_GRAPH_VERSION=v26.0
# Deprecated: the AgentOS tenant context and TrafficMetaConfig binding define access.
META_MARKETING_ADMIN_TEST_ENABLED=false
META_MARKETING_ADMIN_TEST_TENANT_IDS=
META_MARKETING_ADMIN_AD_ACCOUNT_IDS=
META_MARKETING_ADMIN_ACCESS_TOKEN=
META_MARKETING_WRITE_ENABLED=false
META_MARKETING_CAMPAIGN_CREATE_ENABLED=false
META_MARKETING_ADSET_CREATE_ENABLED=false
META_MARKETING_CREATIVE_CREATE_ENABLED=false
META_MARKETING_AD_CREATE_ENABLED=false

# ==========================================
# Hermes remoto LeoFT
# O Hermes roda em outra VPS. Nao colocar tokens reais no repositorio.
# O modo real so deve ser acionado por flag explicita no codigo/script.
# ==========================================
HERMES_REMOTE_BASE_URL=https://app.leoft.com.br
HERMES_LEOFT_PAYMENT_APPROVED_ENDPOINT=/api/internal/hermes/events/leoft/payment-approved
HERMES_LEOFT_TRAINING_REVIEW_ENDPOINT=/api/internal/hermes/events/leoft/training-ready-for-review
HERMES_LEOFT_HMAC_SECRET=
HERMES_LEOFT_HMAC_SIGNATURE_HEADER=X-AgenteOS-Signature
HERMES_LEOFT_HMAC_TIMESTAMP_HEADER=X-AgenteOS-Timestamp
HERMES_LEOFT_HMAC_EVENT_HEADER=X-AgenteOS-Event
HERMES_LEOFT_HMAC_IDEMPOTENCY_HEADER=X-AgenteOS-Idempotency-Key
LEOFT_STUDENT_APP_URL=https://app.leoft.com.br/acesso
HERMES_REMOTE_TIMEOUT_SECONDS=60

# ==========================================
# Telegram real LeoFT (aprovacao de treino)
# Nao colocar token real no repositorio.
# Envio real exige flag explicita no script e LEOFT_TELEGRAM_REAL_ENABLED=true.
MERCADO_PAGO_LEOFT_ACCESS_TOKEN=
MERCADO_PAGO_LEOFT_PUBLIC_KEY=
MERCADO_PAGO_LEOFT_WEBHOOK_SECRET=
# ==========================================
LEOFT_TELEGRAM_REAL_ENABLED=false
LEOFT_TELEGRAM_BOT_TOKEN=
LEOFT_TELEGRAM_TREINOS_CHAT_ID=
LEOFT_APPROVAL_BASE_URL=
